:root{
  --bg:#071a33;
  --bg-2:#0a2342;
  --card:#0d2c52;
  --line:rgba(255,255,255,.12);
  --text:#e8f0fa;
  --muted:#a9bbd2;
  --cyan:#22d3ee;
  --teal:#1fb5a0;
  --gold:#f5b83d;
  --orange:#e8892b;
  --radius:16px;
  --max:1120px;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{
  font-family:system-ui,-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
  background:var(--bg);color:var(--text);line-height:1.6;font-size:16px;
  background-image:radial-gradient(1200px 500px at 85% -10%,rgba(34,211,238,.14),transparent 60%),radial-gradient(900px 400px at -10% 20%,rgba(245,184,61,.08),transparent 60%);
  background-repeat:no-repeat;
}
img{max-width:100%;display:block}
a{color:var(--cyan);text-decoration:none}
a:hover{text-decoration:underline}
.container{width:100%;max-width:var(--max);margin:0 auto;padding:0 20px}
section{padding:64px 0}
.eyebrow{color:var(--gold);font-weight:700;letter-spacing:.12em;font-size:.78rem;text-transform:uppercase;margin-bottom:10px}
h1,h2,h3{line-height:1.2;color:#fff}
h1{font-size:clamp(2.1rem,7vw,3.6rem);font-weight:800;letter-spacing:-.02em}
h2{font-size:clamp(1.6rem,5vw,2.4rem);font-weight:800;letter-spacing:-.01em;margin-bottom:12px}
h3{font-size:1.15rem;font-weight:700;margin-bottom:8px}
.lead{color:var(--muted);font-size:1.08rem;max-width:62ch}
.section-head{margin-bottom:34px}
.grad{background:linear-gradient(90deg,var(--gold),var(--cyan));-webkit-background-clip:text;background-clip:text;color:transparent}

/* header */
header.site{position:sticky;top:0;z-index:50;background:rgba(7,26,51,.88);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.nav{display:flex;align-items:center;justify-content:space-between;height:66px}
.brand{display:flex;align-items:center;gap:10px;color:#fff;font-weight:800;font-size:1.25rem;text-decoration:none}
.brand:hover{text-decoration:none}
.brand img{height:40px;width:auto;border-radius:6px;background:#fff;padding:2px}
.brand .mark{color:var(--cyan)}
.nav ul{display:none;list-style:none;gap:22px}
.nav ul a{color:var(--text);font-size:.95rem;font-weight:500}
.menu-btn{background:none;border:1px solid var(--line);color:#fff;border-radius:10px;padding:8px 12px;font-size:1rem;cursor:pointer}
.nav.open ul{display:flex;flex-direction:column;position:absolute;top:66px;left:0;right:0;background:var(--bg-2);padding:18px 20px;border-bottom:1px solid var(--line)}
@media(min-width:860px){
  .nav ul{display:flex;position:static}
  .menu-btn{display:none}
}

/* buttons */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:0;cursor:pointer;font-weight:800;font-size:1rem;padding:14px 24px;border-radius:999px;text-decoration:none!important;transition:transform .15s,box-shadow .15s}
.btn:hover{transform:translateY(-2px)}
.btn-gold{background:linear-gradient(180deg,#ffd46a,var(--gold) 55%,#e29a1a);color:#0b1e3f;box-shadow:0 8px 24px rgba(245,184,61,.28)}
.btn-ghost{background:transparent;color:#fff;border:1.5px solid var(--cyan)}
.btn-wa{background:#25d366;color:#06361a}
.cta-row{display:flex;flex-wrap:wrap;gap:12px;margin-top:26px}

/* hero */
.hero{padding:56px 0 40px}
.hero h1 .tag{display:block}
.hero p.sub{margin-top:18px;font-size:1.15rem;color:var(--text);max-width:56ch}
.badges{display:flex;flex-wrap:wrap;gap:10px;margin-top:28px}
.badge{border:1px solid var(--line);background:rgba(255,255,255,.04);color:var(--muted);padding:7px 14px;border-radius:999px;font-size:.85rem}

/* cards */
.grid{display:grid;gap:16px}
@media(min-width:640px){.grid.g2,.grid.g3{grid-template-columns:repeat(2,1fr)}}
@media(min-width:960px){.grid.g3{grid-template-columns:repeat(3,1fr)}.grid.g4{grid-template-columns:repeat(4,1fr)}}
.card{background:linear-gradient(180deg,rgba(255,255,255,.05),rgba(255,255,255,.02));border:1px solid var(--line);border-radius:var(--radius);padding:22px}
.card p{color:var(--muted);font-size:.97rem}
.card .ico{width:44px;height:44px;border-radius:12px;display:grid;place-items:center;font-size:1.3rem;background:rgba(34,211,238,.12);border:1px solid rgba(34,211,238,.35);margin-bottom:14px}
.card.hl{border-color:rgba(245,184,61,.5);background:linear-gradient(180deg,rgba(245,184,61,.12),rgba(245,184,61,.03))}
.card.hl .ico{background:rgba(245,184,61,.15);border-color:rgba(245,184,61,.5)}

/* steps */
.steps{counter-reset:s;display:grid;gap:16px}
@media(min-width:860px){.steps{grid-template-columns:repeat(4,1fr)}}
.step{position:relative;background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:24px 20px 20px}
.step::before{counter-increment:s;content:counter(s);position:absolute;top:-14px;left:18px;width:30px;height:30px;border-radius:50%;background:var(--gold);color:#0b1e3f;font-weight:800;display:grid;place-items:center}
.step p{color:var(--muted);font-size:.95rem}

/* use cases */
.uc .tagline{display:inline-block;font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;color:var(--teal);font-weight:700;margin-bottom:8px}
.uc .row{margin-top:10px;font-size:.93rem;color:var(--muted)}
.uc .row b{color:#fff}
.note{margin-top:18px;font-size:.88rem;color:var(--muted);border-left:3px solid var(--orange);padding-left:12px}

/* about */
.about-wrap{display:grid;gap:26px}
@media(min-width:860px){.about-wrap{grid-template-columns:1.2fr 1fr}}
.team{display:grid;gap:14px}
.person{display:flex;gap:14px;align-items:center;background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:16px}
.avatar{flex:none;width:52px;height:52px;border-radius:50%;display:grid;place-items:center;font-weight:800;color:#0b1e3f;background:linear-gradient(135deg,var(--gold),var(--cyan))}
.person small{color:var(--muted)}

/* chat demo */
.chat{max-width:640px;background:var(--bg-2);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden}
.chat-head{padding:12px 16px;border-bottom:1px solid var(--line);font-weight:700;display:flex;justify-content:space-between;align-items:center;gap:10px}
.chat-head span{font-size:.75rem;color:var(--gold);font-weight:600}
.chat-body{height:300px;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:10px}
.msg{max-width:85%;padding:10px 14px;border-radius:14px;font-size:.95rem;white-space:pre-line}
.msg.bot{background:var(--card);border:1px solid var(--line);align-self:flex-start}
.msg.me{background:var(--cyan);color:#05283a;align-self:flex-end;font-weight:600}
.quick{display:flex;flex-wrap:wrap;gap:8px;padding:0 16px 12px}
.quick button{background:transparent;color:var(--cyan);border:1px solid rgba(34,211,238,.5);border-radius:999px;padding:7px 12px;font-size:.85rem;cursor:pointer}
.chat-form{display:flex;border-top:1px solid var(--line)}
.chat-form input{flex:1;background:transparent;border:0;color:#fff;padding:14px 16px;font-size:1rem;outline:none}
.chat-form button{background:var(--gold);border:0;color:#0b1e3f;font-weight:800;padding:0 20px;cursor:pointer}

/* contact */
.contact-wrap{display:grid;gap:26px}
@media(min-width:860px){.contact-wrap{grid-template-columns:1fr 1fr}}
form.contact label{display:block;font-size:.88rem;color:var(--muted);margin:12px 0 6px}
form.contact input,form.contact textarea{width:100%;background:var(--bg-2);border:1px solid var(--line);border-radius:12px;color:#fff;padding:12px 14px;font-size:1rem;font-family:inherit}
form.contact input:focus,form.contact textarea:focus{outline:2px solid var(--cyan);outline-offset:1px}
form.contact textarea{min-height:110px;resize:vertical}
.info li{list-style:none;margin:0 0 14px;color:var(--muted)}
.info b{display:block;color:#fff}
.small{font-size:.85rem;color:var(--muted);margin-top:10px}

/* footer */
footer.site{border-top:1px solid var(--line);padding:30px 0 90px;color:var(--muted);font-size:.9rem}
footer .row{display:flex;flex-wrap:wrap;gap:12px 24px;justify-content:space-between}
footer a{color:var(--muted)}
.wa-float{position:fixed;right:16px;bottom:16px;z-index:60;background:#25d366;color:#06361a;font-weight:800;border-radius:999px;padding:13px 18px;box-shadow:0 8px 22px rgba(0,0,0,.4);text-decoration:none!important}

/* legal pages */
.legal{max-width:780px;padding:48px 0}
.legal h1{font-size:2rem;margin-bottom:6px}
.legal h2{font-size:1.25rem;margin:28px 0 8px}
.legal p,.legal li{color:var(--muted);margin-bottom:10px}
.legal ul{padding-left:22px}
.legal .updated{font-size:.9rem;color:var(--gold)}
