:root{
  --bg:#071a33;
  --bg-2:#0a2342;
  --card:#0d2c52;
  --line:rgba(255,255,255,.12);
  --text:#e8f0fa;
  --muted:#a9bbd2;
  --cyan:#22d3ee;
  --teal:#1fb5a0;
  --gold:#f5b83d;
  --orange:#e8892b;
  --radius:16px;
  --max:1120px;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{
  font-family:system-ui,-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
  background:var(--bg);color:var(--text);line-height:1.6;font-size:16px;
  background-image:radial-gradient(1200px 500px at 85% -10%,rgba(34,211,238,.14),transparent 60%),radial-gradient(900px 400px at -10% 20%,rgba(245,184,61,.08),transparent 60%);
  background-repeat:no-repeat;
}
img{max-width:100%;display:block}
a{color:var(--cyan);text-decoration:none}
a:hover{text-decoration:underline}
.container{width:100%;max-width:var(--max);margin:0 auto;padding:0 20px}
section{padding:64px 0}
.eyebrow{color:var(--gold);font-weight:700;letter-spacing:.12em;font-size:.78rem;text-transform:uppercase;margin-bottom:10px}
h1,h2,h3{line-height:1.2;color:#fff}
h1{font-size:clamp(2.1rem,7vw,3.6rem);font-weight:800;letter-spacing:-.02em}
h2{font-size:clamp(1.6rem,5vw,2.4rem);font-weight:800;letter-spacing:-.01em;margin-bottom:12px}
h3{font-size:1.15rem;font-weight:700;margin-bottom:8px}
.lead{color:var(--muted);font-size:1.08rem;max-width:62ch}
.section-head{margin-bottom:34px}
.grad{background:linear-gradient(90deg,var(--gold),var(--cyan));-webkit-background-clip:text;background-clip:text;color:transparent}

/* header */
header.site{position:sticky;top:0;z-index:50;background:rgba(7,26,51,.88);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
